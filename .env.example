# Copy to .env and fill in. Never commit .env.
DATABASE_URI=postgres://idp:idp@localhost:5432/idp
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public site address, used for absolute links and lead origin URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Studio phone shown in header control 0.1.6 and on the Team page (design projects line)
NEXT_PUBLIC_STUDIO_PHONE=+7 (905) 588-94-88

# Where the content is kept. Leave both empty to keep it in Docker volumes (the default).
# Set full paths to keep it in folders on this computer or on another disk instead, e.g.
#   MEDIA_DIR=/Users/<you>/IDP data/media
#   PGDATA_DIR=/Users/<you>/IDP data/postgres
# Uploaded photos and videos. Also used by `npm run dev`, which otherwise writes to ./media
MEDIA_DIR=
# Database files, used by Docker only (`npm run dev` reaches the database through DATABASE_URI).
# Must be an empty folder the first time; see "Where the data is kept" in README.md
PGDATA_DIR=
