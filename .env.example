# Copy to .env and fill in. Never commit .env.
DATABASE_URI=postgres://idp:idp@localhost:5432/idp
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public site address, used for absolute links and lead origin URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Studio phone shown in header control 0.1.6 and on the Team page (design projects line)
NEXT_PUBLIC_STUDIO_PHONE=+7 (905) 588-94-88

# Where the content is kept: one folder holding media/ (photos and videos), backup/ (backups) and db/ (the database).
# Empty: ./data in the site folder. Used by `docker compose` and by `npm run dev`, so both see the same content.
# Or a full path, e.g. on another disk: DATA_DIR=/Users/<you>/IDP data. See "Data locations" in CLAUDE.md
DATA_DIR=
