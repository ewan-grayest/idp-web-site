# Copy to deploy/.env on the server only. Never commit or share it.
# Domain only, no https://
SITE_DOMAIN=example.ru
# Full address, with https://
NEXT_PUBLIC_SITE_URL=https://example.ru
POSTGRES_PASSWORD=long-random-string
PAYLOAD_SECRET=another-long-random-string
# All of these are read when the site starts: `up -d` applies a change, no rebuild needed

# The content is kept in the persistent Docker volumes deploy_media, deploy_backup and deploy_db, mounted at
# /data/media, /data/backup and /data/db ("Data locations" in CLAUDE.md).

# docker-compose.behind-proxy.yml only: where your proxy reaches the site. Default 127.0.0.1:3000, e.g. 8080 for all interfaces
APP_BIND=
