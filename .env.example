# Copy to .env and fill in. Never commit .env.
DATABASE_URI=postgres://idp:idp@localhost:5432/idp
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public site address, used for absolute links and lead origin URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Studio phone shown in header control 0.1.6 and on the Team page (design projects line)
NEXT_PUBLIC_STUDIO_PHONE=+7 (905) 588-94-88

# Where the content is kept: in Docker, the persistent volumes site_media, site_backup and site_db, mounted at
# /data/media, /data/backup and /data/db ("Data locations" in CLAUDE.md). `npm run dev` runs outside Docker and
# uses media/ and backups/ in the site folder instead, with the database in the db container.
