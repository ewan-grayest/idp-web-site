# Copy to deploy/.env on the server only. Never commit or share it.
SITE_DOMAIN=example.ru
NEXT_PUBLIC_SITE_URL=https://example.ru
POSTGRES_PASSWORD=long-random-string
PAYLOAD_SECRET=another-long-random-string
NEXT_PUBLIC_STUDIO_PHONE=+7 (905) 588-94-88
# Optional: promo video file address (leave empty for the placeholder)
NEXT_PUBLIC_PROMO_VIDEO_URL=
# NEXT_PUBLIC_* values are baked in at build time: rebuild (up -d --build) after changing them

# Where the content is kept. Empty: Docker volumes (the default). Or full paths on the server, e.g. a mounted disk:
#   MEDIA_DIR=/srv/idp/media     (the app makes it writable for its user on start)
#   PGDATA_DIR=/srv/idp/postgres (an empty folder the first time)
MEDIA_DIR=
PGDATA_DIR=
